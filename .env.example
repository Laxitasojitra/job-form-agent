# Copy this file to ".env", then keep ONE "main" block and (optionally) ONE "backup" block.
# Lines starting with # are ignored. .env is in .gitignore, so keys never go to GitHub.

# =====================================================================
# MAIN: Groq (free, cloud, very fast, no card needed)
# Get a key: https://console.groq.com/keys
# =====================================================================
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste_your_groq_key_here
LLM_MODEL=openai/gpt-oss-20b

# =====================================================================
# BACKUP: Ollama (free, runs on YOUR laptop, data never leaves it)
# Install: https://ollama.com/download   then run:  ollama pull granite4:3b
# Used automatically only if the main one fails.
# =====================================================================
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=granite4:3b

# ---------------------------------------------------------------------
# Other options (copy into the main or backup block if you want them)
# ---------------------------------------------------------------------
# Groq, bigger model:   LLM_MODEL=qwen/qwen3.8-27b
# Gemini free tier:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                       LLM_MODEL=gemini-3.8-flash
# Ollama as MAIN (fully private):
#                       LLM_BASE_URL=http://localhost:11434/v1
#                       LLM_API_KEY=ollama
#                       LLM_MODEL=granite4:3b
